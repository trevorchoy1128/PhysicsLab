{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest", "--browser", "chrome"]
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "pdf-reader": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@sylphx/pdf-reader-mcp"]
    }
  }
}
